#!/usr/bin/env bash

# ─── Continue with your existing vars ──────────
source ./scripts/lib/environment-variables.bash
source ./scripts/lib/functions.bash
source ./scripts/lib/dist-determine.bash

prevent_sudo_or_root
set -e

# ─── Colors & Logging ─────────────────────────────
log()   { printf "\033[1;32m[INFO]\033[0m $(pretty_path "$1")"; }
warn()  { printf "\033[1;33m[WARN]\033[0m $(pretty_path "$1")"; }
error() { printf "\033[1;31m[ERROR]\033[0m $(pretty_path "$1")"; }

echo_cmd() { printf "\033[1;32m───\033[0m $(pretty_path "$1")"; }
log_cmd()  { printf "\033[1;32m───>\033[0m $(pretty_path "$1")"; }
run_cmd() {
    # Build a pretty display of the command, replacing $HOME with ~
    local display_cmd=()
    for arg in "$@"; do
        display_cmd+=("$(pretty_path "$arg")")
    done

    printf "\033[1;34m>>> ${display_cmd[*]}\033[0m"
    "$@"
}

header()   { printf "\n\033[1;35m───── $1 ─────\033[0m\n"; }

pretty_path() {
    local path="$1"
    # Absolute path starting with $HOME → replace with ~
    if [[ "$path" == "$HOME"* ]]; then
        echo "~${path#$HOME}"
    else
        echo "$path"
    fi
}

# ─── Detect Shell & Distro ──────────────────────
USER_SHELL=$(basename "$SHELL")
USER_SHELL="${USER_SHELL^}"

export OS_GROUP_ID
export OS_DISTRO_ID
export OS_DISTRO_ID_LIKE
export DISTRO="$OS_GROUP_ID"
export PKG_DIR

#printf "OS_GROUP_ID: %s\nOS_DISTRO_ID: %s\nOS_DISTRO_ID_LIKE: %s\nDISTRO: %s\nPKG_DIR: %s\n" "${OS_GROUP_ID}" "${OS_DISTRO_ID}" "${OS_DISTRO_ID_LIKE}" "${DISTRO}" "${PKG_DIR}"

# ─── Menu (Manual Mode) ─────────────────────────
show_menu() {
    header "Nixie's Multi-Distro Bootstrap"
    log_cmd "Detected distro: $OS_GROUP_ID\n"
    log_cmd "Detected shell: $USER_SHELL\n"
    echo ""

    # Menu titles
    options=(
        "Update System Packages"
        "Install Packages"
        "Symlink Configs"
        "Setup Shell"
        "Install Flatpaks"
        "Exit"
    )

    # Matching scripts (relative to SCRIPTS_DIR)
    scripts=(
        "update_system.bash"
        "install_pkgs.bash"
        "symlink.bash"
        "setup_shell.bash"
        "install_flatpak.bash"
    )

    while true; do
        for i in "${!options[@]}"; do
            echo -e "\033[1;32m$((i+1)).\033[0m ${options[$i]}"
        done

        read -rp $'\nChoose what to run (or q to quit): ' choice
        case "$choice" in
            1) v "$SCRIPTS_DIR/${scripts[0]}" ;;
            2) v "$SCRIPTS_DIR/${scripts[1]}" ;;
            3) v "$SCRIPTS_DIR/${scripts[2]}" ;;
            4) v "$SCRIPTS_DIR/${scripts[3]}" ;;
            5) v "$SCRIPTS_DIR/${scripts[4]}" ;;
            6|q|Q|e) echo_cmd "Goodbye!"; break ;;
            *) warn "Invalid choice." ;;
        esac
        echo
    done
}

x show_menu

pkgx_intro() {
    echo ""
    printf "\033[1;32m─────>\033[0m pkgx is a cross-distro package frontend."
    printf "\n\033[1;32m─────>\033[0m Features:"
    printf "\n\033[1;32m─────>\033[0m   • Unified commands across distros"
    printf "\n\033[1;32m─────>\033[0m   • Optional, non-invasive"
    printf "\n\033[1;32m─────>\033[0m   • Installs to user space by default"
    printf "\n\033[1;32m─────>\033[0m   • Supports pacman, pkg, and apt.\n"
    echo ""
}

if [[ -f "$SCRIPTS_DIR/pkgx.bash" ]]; then
    echo "─────────────────────────────────────────────────────────────────────────────────"
    pkgx_intro
    echo ""
    source $SCRIPTS_DIR/pkgx.bash
    showfun install_pkgx
    echo ""
    z install_pkgx
fi

